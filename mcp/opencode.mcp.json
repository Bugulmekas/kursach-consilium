{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browse": {
      "type": "local",
      "command": [
        "C:\\Users\\<user>\\.local\\bin\\browse.exe",
        "mcp"
      ],
      "cwd": "~",
      "pool": true,
      "environment": {
        "OPENCODE_BROWSER_RUNTIME": "auto-update"
      }
    },
    "word-live": {
      "type": "local",
      "command": [
        "C:\\Users\\<user>\\.local\\bin\\uvx.exe",
        "--from",
        "word-mcp-live",
        "word_mcp_server.exe"
      ],
      "timeout": {
        "startup": 120000,
        "catalog": 60000
      }
    }
  }
}
